<%- include("partials/header") %>
    <h2>Create a new message</h2>

    <%- include("partials/form-errors") %>

    <%# title = page title; values.title = the message title the user typed %>
    <form action="/messages/new" method="post" class="form">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required maxlength="255"
             value="<%= values.title || '' %>">

      <label for="text">Message</label>
      <textarea id="text" name="text" rows="6" required maxlength="2000"><%= values.text || '' %></textarea>

      <button type="submit">Post message</button>
    </form>
<%- include("partials/footer") %>
