<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a href="/">Members Only</a></h1>
    <nav>
      <% if (currentUser) { %>
        <span>Hi, <%= currentUser.first_name %></span>
        <% if (currentUser.is_member) { %>
          <span class="badge">Member</span>
        <% } else { %>
          <a href="/join-club">Join the club</a>
        <% } %>
        <% if (currentUser.is_admin) { %>
          <span class="badge">Admin</span>
        <% } else { %>
          <a href="/become-admin">Become admin</a>
        <% } %>
        <a href="/messages/new">Create a new message</a>
        <form action="/log-out" method="post" class="inline-form">
          <button type="submit" class="link-button">Log out</button>
        </form>
      <% } else { %>
        <a href="/sign-up">Sign up</a>
        <a href="/log-in">Log in</a>
      <% } %>
    </nav>
  </header>
  <main>
    <% if (currentUser) { %>
      <p>Welcome to the clubhouse, <%= currentUser.first_name %>.</p>
    <% } else { %>
      <p>Welcome to the clubhouse.</p>
    <% } %>

    <% if (!isMember) { %>
      <p class="hint">Only club members can see who wrote each message and when.</p>
    <% } %>

    <% if (messages.length === 0) { %>
      <p>No messages yet.</p>
    <% } %>

    <% messages.forEach((message) => { %>
      <article class="message">
        <h2><%= message.title %></h2>
        <p class="message-text"><%= message.text %></p>
        <% if (isMember) { %>
          <p class="message-meta">
            By <%= message.author %> ·
            <time datetime="<%= message.isoDate %>"><%= message.date %></time>
          </p>
        <% } else { %>
          <p class="message-meta">By Anonymous</p>
        <% } %>
        <% if (isAdmin) { %>
          <form action="/messages/<%= message.id %>/delete" method="post"
                class="delete-form" onsubmit="return confirm('Delete this message?');">
            <button type="submit" class="link-button danger">Delete</button>
          </form>
        <% } %>
      </article>
    <% }) %>
  </main>
</body>
</html>
