<%- include("partials/header") %>
    <% if (currentUser) { %>
      <p>Welcome to the clubhouse, <%= currentUser.first_name %>.</p>
    <% } else { %>
      <p>Welcome to the clubhouse.</p>
    <% } %>

    <% if (!isMember) { %>
      <p class="hint">Only club members can see who wrote each message and when.</p>
    <% } %>

    <% if (messages.length === 0) { %>
      <p>No messages yet.</p>
    <% } %>

    <% messages.forEach((message) => { %>
      <article class="message">
        <h2><%= message.title %></h2>
        <p class="message-text"><%= message.text %></p>
        <% if (isMember) { %>
          <p class="message-meta">
            By <%= message.author %> ·
            <time datetime="<%= message.isoDate %>"><%= message.date %></time>
          </p>
        <% } else { %>
          <p class="message-meta">By Anonymous</p>
        <% } %>
        <% if (isAdmin) { %>
          <form action="/messages/<%= message.id %>/delete" method="post"
                class="delete-form" data-title="<%= message.title %>">
            <button type="submit" class="link-button danger">Delete</button>
          </form>
        <% } %>
      </article>
    <% }) %>

    <% if (isAdmin) { %>
      <%# One shared pop-up; public/js/confirm-delete.js opens it for whichever Delete was clicked %>
      <dialog id="delete-dialog" class="dialog">
        <%# method="dialog": buttons close the pop-up and set dialog.returnValue, no request sent %>
        <form method="dialog">
          <h2>Delete message?</h2>
          <p>"<span id="delete-dialog-title"></span>" will be removed for everyone. This can't be undone.</p>
          <div class="dialog-actions">
            <button value="cancel" class="secondary-button">Cancel</button>
            <button value="confirm" class="danger-button">Delete</button>
          </div>
        </form>
      </dialog>
      <script src="/js/confirm-delete.js" defer></script>
    <% } %>
<%- include("partials/footer") %>
