<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a href="/">Members Only</a></h1>
    <nav>
      <% if (currentUser) { %>
        <span>Hi, <%= currentUser.first_name %></span>
        <form action="/log-out" method="post" class="inline-form">
          <button type="submit" class="link-button">Log out</button>
        </form>
      <% } else { %>
        <a href="/sign-up">Sign up</a>
        <a href="/log-in">Log in</a>
      <% } %>
    </nav>
  </header>
  <main>
    <% if (currentUser) { %>
      <p>Welcome to the clubhouse, <%= currentUser.first_name %>.</p>
    <% } else { %>
      <p>Welcome to the clubhouse.</p>
    <% } %>
  </main>
</body>
</html>
