# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/members_only

# Signs the session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Secret passcode to become a member (unset = nobody can join)
CLUB_PASSCODE=replace-me

# Secret passcode to become an admin; keep it different from CLUB_PASSCODE
ADMIN_PASSCODE=replace-me-too

# Optional: port to listen on (default 8000)
# PORT=8000

# Optional: set to production when deployed over HTTPS (secure cookies)
# NODE_ENV=production
